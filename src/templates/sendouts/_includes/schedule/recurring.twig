{% import '_includes/forms' as forms %}

{% include 'campaign/sendouts/_includes/schedule/dates' %}

{% set input %}
    {{ "Every"|t('campaign') }}
    {% if editable %}
        {{ forms.text({
            name: 'schedule[frequency]',
            type: 'number',
            value: schedule.frequency,
            size: '10',
        }) }}
        {{ forms.select({
            name: 'schedule[frequencyInterval]',
            options: schedule.getIntervalOptions(),
            value: schedule.frequencyInterval,
            toggle: true,
            targetPrefix: 'frequency-',
        }) }}
    {% else %}
        {{ schedule.frequency }} {{ schedule.getIntervalOptions()[schedule.frequencyInterval] }}
    {% endif %}
{% endset %}
{{ forms.field({
    label: "Frequency"|t('campaign'),
    instructions: "The frequency at which recurring sendouts should be sent."|t('campaign'),
    errors: schedule.getErrors('frequency'),
    required: true,
}, input) }}

<div id="frequency-weeks" {{ schedule.frequencyInterval != 'weeks' ? 'class="hidden"' }}>

    {% include 'campaign/sendouts/_includes/schedule/daysOfWeek' %}

</div>

<div id="frequency-months" {{ schedule.frequencyInterval != 'months' ? 'class="hidden"' }}>

    {% set input %}
        {% if editable %}
            {{ forms.select({
                name: 'schedule[monthlyScheduleType]',
                options: schedule.getMonthlyScheduleTypeOptions(),
                value: schedule.monthlyScheduleType,
                toggle: true,
                targetPrefix: 'monthly-schedule-',
            }) }}
        {% else %}
            {{ schedule.getMonthlyScheduleTypeOptions()[schedule.monthlyScheduleType] }}
        {% endif %}
    {% endset %}
    {{ forms.field({
        label: "Schedule By"|t('campaign'),
        instructions: "Whether to send on specific days of the month or on selected days of the week."|t('campaign'),
        errors: schedule.getErrors('monthlyScheduleType'),
        required: true,
    }, input) }}

    <div id="monthly-schedule-daysOfMonth" {{ schedule.monthlyScheduleType != 'daysOfMonth' ? 'class="hidden"' }}>

        {% set input %}
            {% set days = [] %}
            {% for day in 1..31 %}
                {% set day = (day == 29 ? day ~ ' (may not exist in all months)' : day) %}
                {% set day = (day > 29 ? day ~ ' (does not exist in all months)' : day) %}
                {% if editable %}
                    {% set days = days|merge([forms.checkbox({
                        label: day|t('campaign'),
                        name: 'schedule[daysOfMonth][' ~ loop.index ~ ']',
                        value: 1,
                        checked: (schedule.daysOfMonth[loop.index] is defined and schedule.daysOfMonth[loop.index]),
                    })]) %}
                {% elseif schedule.daysOfMonth[loop.index] is defined and schedule.daysOfMonth[loop.index] %}
                    {% set days = days|merge([day]) %}
                {% endif %}
            {% endfor %}
            {{ editable ? days|join('<br>')|raw : days|join(', ') }}
        {% endset %}
        {{ forms.field({
            label: "Days of Month"|t('campaign'),
            instructions: "The days of the month on which to send."|t('campaign'),
            errors: schedule.getErrors('daysOfMonth'),
            required: true
        }, input) }}

    </div>

    <div id="monthly-schedule-daysOfWeek" {{ schedule.monthlyScheduleType != 'daysOfWeek' ? 'class="hidden"' }}>

        {% set input %}
            {% if editable %}
                {{ forms.multiselect({
                    name: 'schedule[weeksOfMonth]',
                    options: schedule.getWeekOfMonthOptions(),
                    values: schedule.weeksOfMonth,
                    size: 6,
                }) }}
            {% else %}
                {% set weeks = [] %}
                {% for value, label in schedule.getWeekOfMonthOptions() %}
                    {% if value in schedule.weeksOfMonth %}
                        {% set weeks = weeks|merge([label]) %}
                    {% endif %}
                {% endfor %}
                {{ weeks|join(', ') }}
            {% endif %}
        {% endset %}
        {{ forms.field({
            label: "On the"|t('campaign'),
            instructions: "The occurrences of the selected days of the week on which to send."|t('campaign'),
            errors: schedule.getErrors('weeksOfMonth'),
            required: true,
        }, input) }}

        {% include 'campaign/sendouts/_includes/schedule/daysOfWeek' with {
            daysOfWeekAttribute: 'daysOfWeekInMonth',
        } %}

    </div>

</div>

{% include 'campaign/sendouts/_includes/schedule/timeOfDay' %}

{{ forms.lightswitchField({
    label: "Can Send To Contacts Multiple Times"|t('campaign'),
    instructions: "Whether the sendout can be sent to contacts multiple times."|t('campaign'),
    name: 'schedule[canSendToContactsMultipleTimes]',
    on: schedule.canSendToContactsMultipleTimes,
    errors: schedule.getErrors('canSendToContactsMultipleTimes'),
    disabled: not editable,
}) }}

{% include 'campaign/sendouts/_includes/schedule/condition' %}
