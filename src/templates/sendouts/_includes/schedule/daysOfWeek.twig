{% import '_includes/forms' as forms %}
{% set daysOfWeekAttribute = daysOfWeekAttribute ?? 'daysOfWeek' %}
{% set selectedDays = schedule[daysOfWeekAttribute] %}

{% set input %}
    {% set days = [] %}
    {% for day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] %}
        {% if editable %}
            {% set days = days|merge([forms.checkbox({
                label: day|t('campaign'),
                name: 'schedule[' ~ daysOfWeekAttribute ~ '][' ~ loop.index ~ ']',
                value: 1,
                checked: (selectedDays[loop.index] is defined and selectedDays[loop.index]),
            })]) %}
        {% elseif selectedDays[loop.index] is defined and selectedDays[loop.index] %}
            {% set days = days|merge([day]) %}
        {% endif %}
    {% endfor %}
    {{ editable ? days|join('<br>')|raw : days|join(', ') }}
{% endset %}
{{ forms.field({
    label: "Days of Week"|t('campaign'),
    instructions: "The days of the week on which to send."|t('campaign'),
    errors: schedule.getErrors(daysOfWeekAttribute),
    required: true,
}, input) }}
